{
  "name": "ai-v",
  "version": "0.1.0",
  "description": "HK football value picks dashboard workspace",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-stable.mjs",
    "dev:raw": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --workspace @aiv/api run dev",
    "dev:web": "npm --workspace @aiv/web run dev",
    "build": "npm run build:api && npm run build:web",
    "build:api": "npm --workspace @aiv/api run build",
    "build:web": "npm --workspace @aiv/web run build",
    "deploy:web:prod": "npm --workspace @aiv/web run build && cd apps/web && npx vercel --prod --yes",
    "lint": "npm run lint:api && npm run lint:web",
    "lint:api": "npm --workspace @aiv/api run lint",
    "lint:web": "npm --workspace @aiv/web run lint",
    "test": "npm --workspace @aiv/api run test"
  },
  "keywords": [
    "football",
    "betting",
    "analysis"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
